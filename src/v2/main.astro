---
import { Icon } from "astro-icon/components";
---

<style is:global>
  ::selection {
    background-color: #7b9e12;
    color: #000;
  }
  #grid-pattern > *:nth-child(odd),
  #loader-grid > *:nth-child(odd) {
    background-color: var(--color-terminal-orange);
  }
  #grid-pattern.inverted > *:nth-child(odd),
  #loader-grid.inverted > *:nth-child(odd) {
    background-color: transparent;
  }
  #grid-pattern.inverted > *:nth-child(even),
  #loader-grid.inverted > *:nth-child(even) {
    background-color: var(--color-terminal-orange);
  }
  #loader.loader-hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>

<section
  id="terminal-section"
  class="fixed inset-0 flex items-center justify-center bg-black"
>
  <div
    id="terminal-content"
    class="flex w-[270px] sm:w-[335px] flex-col gap-y-0 sm:gap-y-0.5 text-left font-geist-mono text-[12px] uppercase leading-normal tracking-normal text-terminal-orange antialiased sm:text-[14px] md:text-[15px]"
  >
    <div class="mb-1 flex items-center gap-x-2 justify-between">
      <span
        class="inline-block rounded-full border border-terminal-orange bg-transparent px-2 py-px font-cormorant font-bold leading-normal"
      >
        LUCAS BLANCO
      </span>
      <div id="grid-pattern" class="grid size-[1.6em] shrink-0 grid-cols-5 grid-rows-5">
        {Array.from({ length: 25 }).map(() => <div />)}
      </div>
    </div>

    <div class="flex w-full justify-between gap-x-4">
      <span>DESARROLLADOR WEB</span>
      <span>CORDOBA, ARG</span>
    </div>

    <div class="flex w-full items-center">
      <span class="flex">
        <a
          href="https://flexxus.com.ar/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-150 hover:text-[#7b9e12]"
        >
          @FLEXXUS
        </a>
      </span>
       <span class="flex-1 mx-1"><canvas class="pixel-divider"></canvas></span>
      <span>2025 // ACTUALIDAD</span>
    </div>

    <div class="flex w-full items-center">
      <span class="flex">
        <a
          href="https://austral.cz/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-150 hover:text-[#7b9e12]"
        >
          @AGENCIA AUSTRAL
        </a>
      </span>
        <span class="flex-1 mx-1"><canvas class="pixel-divider"></canvas></span>
      <span>2024 // 2025</span>
    </div>

    <div class="flex w-full justify-between gap-x-4 items-center">
      <span class="flex gap-x-2">
        <a
          href="https://github.com/lucasmblanco"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-150 hover:text-[#7b9e12]"
        >
          <Icon name="simple-icons:github" class="size-4" />
        </a>
        <a
          href="https://www.linkedin.com/in/lucas-matias-blanco/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-150 hover:text-[#7b9e12]"
        >
          <Icon name="simple-icons:linkedin" class="size-4" />
        </a>
        <a
          href="https://docs.google.com/document/d/19bXAvpYcYM8dzHZPdBtAiU6QkCzAiFp7jatZen_mZjg/edit?tab=t.0"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-150 hover:text-[#7b9e12]"
        >
          <Icon name="pixelarticons:file" class="size-4" />
        </a>
      </span>
      <span class="flex items-center gap-x-1">&#9678; 2026</span>
    </div>
  </div>
</section>

<div id="fallback-glow"></div>
<canvas id="fallback-noise"></canvas>

<style>
  #fallback-glow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse clamp(200px, 80vw, 420px) clamp(55px, 24vh, 110px) at 49% 52%, var(--color-terminal-orange) 0%, var(--color-terminal-orange) 25%, transparent 100%),
      radial-gradient(ellipse clamp(180px, 72vw, 380px) clamp(40px, 16vh, 80px) at 51% 48%, var(--color-terminal-orange) 0%, var(--color-terminal-orange) 20%, transparent 95%);
    opacity: 0.16;
    filter: blur(12px);
    transform: rotate(-4.5deg);
    mix-blend-mode: screen;
  }
  #fallback-noise {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: overlay;
    opacity: 0.2;
  }
  .fallback-hidden { display: none !important; }
  @media (prefers-reduced-motion: reduce) {
    #fallback-noise { display: none !important; }
  }
</style>

<script>
  (function () {
    var nCanvas = document.getElementById('fallback-noise');
    if (!nCanvas) return;
    var nCtx = nCanvas.getContext('2d');

    function noise() {
      var dpr = window.devicePixelRatio || 1;
      var nw = Math.max(512, Math.floor(nCanvas.clientWidth * dpr / 2));
      var nh = Math.max(300, Math.floor(nCanvas.clientHeight * dpr / 2));
      if (nCanvas.width !== nw || nCanvas.height !== nh) {
        nCanvas.width = nw;
        nCanvas.height = nh;
      }
      var d = nCtx.createImageData(nw, nh).data;
      for (var i = 0; i < d.length; i += 4) {
        var ra = Math.random(), rb = Math.random(), rc = Math.random();
        d[i]     = ra > 0.65 ? 255 : (ra > 0.2 ? Math.random() * 120 : 0);
        d[i + 1] = rb > 0.65 ? 255 : (rb > 0.2 ? Math.random() * 120 : 0);
        d[i + 2] = rc > 0.65 ? 255 : (rc > 0.2 ? Math.random() * 120 : 0);
        d[i + 3] = 255;
      }
      nCtx.putImageData(new ImageData(d, nw, nh), 0, 0);
      requestAnimationFrame(noise);
    }
    noise();
  })();
</script>

<script>
  (function () {
    'use strict';

    var BLOOM_THRESHOLD = 0.01;
    var BLOOM_INTENSITY = 10.0;
    var NOISE_INTENSITY = 0.06;

    var VERT_SRC = `#version 300 es
in vec2 aPosition;
out vec2 vUv;
void main() {
  vUv = aPosition * 0.5 + 0.5;
  gl_Position = vec4(aPosition, 0.0, 1.0);
}`;

    var BLOOM_EXTRACT_SRC = `#version 300 es
precision highp float;
uniform sampler2D uTexture;
uniform float uThreshold;
in vec2 vUv;
out vec4 fragColor;
void main() {
  vec4 color = texture(uTexture, vUv);
  float brightness = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
  float soft = smoothstep(uThreshold, uThreshold + 0.25, brightness);
  fragColor = color * soft;
}`;

    var BLOOM_BLUR_SRC = `#version 300 es
precision highp float;
uniform sampler2D uTexture;
uniform vec2 uTexelSize;
uniform vec2 uDirection;
uniform float uSpread;
in vec2 vUv;
out vec4 fragColor;
void main() {
  vec4 color = vec4(0.0);
  float w[9] = float[](0.1536, 0.1443, 0.1207, 0.0904, 0.0604, 0.0360, 0.0192, 0.0091, 0.0039);
  color += texture(uTexture, vUv) * w[0];
  for (int i = 1; i < 9; i++) {
    vec2 off = uDirection * float(i) * uTexelSize * uSpread;
    color += texture(uTexture, vUv + off) * w[i];
    color += texture(uTexture, vUv - off) * w[i];
  }
  fragColor = color;
}`;

    var COMPOSITE_SRC = `#version 300 es
precision highp float;
uniform sampler2D uOriginal;
uniform sampler2D uBloom;
uniform float uTime;
uniform float uNoiseIntensity;
uniform float uBloomIntensity;
in vec2 vUv;
out vec4 fragColor;
float rand(vec2 co) {
  vec3 p3 = fract(co.xyx * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}
void main() {
  vec4 original = texture(uOriginal, vUv);
  vec4 bloom = texture(uBloom, vUv);
  vec3 color = original.rgb + bloom.rgb * uBloomIntensity;
  float frame = floor(uTime * 18.0);
  float grain = (rand(gl_FragCoord.xy * 1.0 + frame * 0.73) - 0.5) * uNoiseIntensity * 2.5;
  color += grain;
  fragColor = vec4(color, 1.0);
}`;

    function createShader(gl, type, source) {
      var shader = gl.createShader(type);
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        console.error('Shader:', gl.getShaderInfoLog(shader));
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    }

    function createProgram(gl, vertSrc, fragSrc) {
      var vs = createShader(gl, gl.VERTEX_SHADER, vertSrc);
      var fs = createShader(gl, gl.FRAGMENT_SHADER, fragSrc);
      if (!vs || !fs) return null;
      var prog = gl.createProgram();
      gl.attachShader(prog, vs);
      gl.attachShader(prog, fs);
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
        console.error('Program:', gl.getProgramInfoLog(prog));
        return null;
      }
      return prog;
    }

    function createFBO(gl, width, height) {
      var tex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, width, height, 0, gl.RGBA, gl.FLOAT, null);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      var fbo = gl.createFramebuffer();
      gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
      return { fbo: fbo, tex: tex, width: width, height: height };
    }

    function init() {
      var testCanvas = document.createElement('canvas');
      var testCtx = testCanvas.getContext('2d');
      if (!testCtx || typeof testCtx.drawElementImage !== 'function') return;

      var testGl = document.createElement('canvas').getContext('webgl2');
      if (!testGl) return;

      document.getElementById('fallback-glow').classList.add('fallback-hidden');
      document.getElementById('fallback-noise').classList.add('fallback-hidden');
      document.getElementById('loader').classList.add('loader-hidden');

      var section = document.getElementById('terminal-section');
      if (!section) return;

      var captureCanvas = document.createElement('canvas');
      captureCanvas.setAttribute('layoutsubtree', '');
      captureCanvas.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#000;z-index:0;';

      section.style.position = 'static';
      section.style.width = '100%';
      section.style.height = '100%';
      section.style.display = 'flex';
      section.style.alignItems = 'center';
      section.style.justifyContent = 'center';
      section.style.background = '#000';

      captureCanvas.appendChild(section);
      document.body.appendChild(captureCanvas);

      captureCanvas.onpaint = function() {
        requestAnimationFrame(function() {
          setupWebGL(captureCanvas, section);
        });
        captureCanvas.onpaint = null;
      };
    }

    function setupWebGL(captureCanvas, content) {
      var captureCtx = captureCanvas.getContext('2d');
      if (!captureCtx || typeof captureCtx.drawElementImage !== 'function') return;

      if (typeof captureCanvas.captureElementImage !== 'function') return;

      var glCanvas = document.createElement('canvas');
      glCanvas.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;';
      document.body.appendChild(glCanvas);

      var gl = glCanvas.getContext('webgl2', { alpha: false, antialias: false });
      if (!gl) { glCanvas.remove(); return; }

      gl.getExtension('EXT_color_buffer_float');

      var extractProg = createProgram(gl, VERT_SRC, BLOOM_EXTRACT_SRC);
      var blurProg = createProgram(gl, VERT_SRC, BLOOM_BLUR_SRC);
      var compositeProg = createProgram(gl, VERT_SRC, COMPOSITE_SRC);
      if (!extractProg || !blurProg || !compositeProg) { restore(); return; }

      var quadVerts = new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]);
      var vao = gl.createVertexArray();
      gl.bindVertexArray(vao);
      var vbo = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
      gl.bufferData(gl.ARRAY_BUFFER, quadVerts, gl.STATIC_DRAW);
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

      var uThreshold = gl.getUniformLocation(extractProg, 'uThreshold');
      var uExtractTex = gl.getUniformLocation(extractProg, 'uTexture');
      var uBlurTex = gl.getUniformLocation(blurProg, 'uTexture');
      var uBlurTexelSize = gl.getUniformLocation(blurProg, 'uTexelSize');
      var uBlurDirection = gl.getUniformLocation(blurProg, 'uDirection');
      var uBlurSpread = gl.getUniformLocation(blurProg, 'uSpread');
      var uOrigTex = gl.getUniformLocation(compositeProg, 'uOriginal');
      var uBloomTex = gl.getUniformLocation(compositeProg, 'uBloom');
      var uTime = gl.getUniformLocation(compositeProg, 'uTime');
      var uNoiseInt = gl.getUniformLocation(compositeProg, 'uNoiseIntensity');
      var uBloomInt = gl.getUniformLocation(compositeProg, 'uBloomIntensity');

      var dpr = window.devicePixelRatio || 1;
      var w, h, bw, bh;
      var fboA, fboB;
      var contentTex = gl.createTexture();

      function resize() {
        dpr = window.devicePixelRatio || 1;
        w = Math.floor(glCanvas.clientWidth * dpr);
        h = Math.floor(glCanvas.clientHeight * dpr);
        glCanvas.width = w;
        glCanvas.height = h;
        bw = Math.floor(w / 4);
        bh = Math.floor(h / 4);
        if (fboA) resizeFBO(gl, fboA, bw, bh);
        else fboA = createFBO(gl, bw, bh);
        if (fboB) resizeFBO(gl, fboB, bw, bh);
        else fboB = createFBO(gl, bw, bh);
      }

      function resizeFBO(gl, fboData, width, height) {
        gl.bindTexture(gl.TEXTURE_2D, fboData.tex);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, width, height, 0, gl.RGBA, gl.FLOAT, null);
        fboData.width = width;
        fboData.height = height;
      }

      resize();
      window.addEventListener('resize', function () {
        resize();
        gl.viewport(0, 0, w, h);
      });

      function captureContent(content) {
        try {
          var elementImage = captureCanvas.captureElementImage(content);
          captureCanvas.width = elementImage.width;
          captureCanvas.height = elementImage.height;
          captureCtx.drawElementImage(elementImage, 0, 0);
          gl.bindTexture(gl.TEXTURE_2D, contentTex);
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, captureCanvas);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          elementImage.close();
          return true;
        } catch (e) {
          console.error('captureContent failed:', e.message);
          return false;
        }
      }

      if (!captureContent(content)) {
        console.error('CAPTURE FAILED - restoring');
        restore();
        return;
      }
      console.log('CAPTURE METHOD: captureElementImage + drawElementImage works');
      document.getElementById('fallback-glow').classList.add('fallback-hidden');
      document.getElementById('fallback-noise').classList.add('fallback-hidden');
      document.getElementById('loader').classList.add('loader-hidden');

      function render(time) {
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);

        if (!captureContent(content)) return;

        gl.bindVertexArray(vao);

        gl.viewport(0, 0, bw, bh);
        gl.useProgram(extractProg);
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, contentTex);
        gl.uniform1i(uExtractTex, 0);
        gl.uniform1f(uThreshold, BLOOM_THRESHOLD);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fboA.fbo);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        gl.viewport(0, 0, bw, bh);
        gl.useProgram(blurProg);
        gl.uniform1i(uBlurTex, 0);
        gl.uniform2f(uBlurTexelSize, 1.0 / bw, 1.0 / bh);

        // Blur horizontal (wide spread = eye shape)
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, fboA.tex);
        gl.uniform2f(uBlurDirection, 1.0, 0.0);
        gl.uniform1f(uBlurSpread, 4.5);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fboB.fbo);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        // Blur vertical (narrow spread)
        gl.bindTexture(gl.TEXTURE_2D, fboB.tex);
        gl.uniform2f(uBlurDirection, 0.0, 1.0);
        gl.uniform1f(uBlurSpread, 1.4);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fboA.fbo);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        // Second horizontal pass (wider)
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, fboA.tex);
        gl.uniform2f(uBlurDirection, 1.0, 0.0);
        gl.uniform1f(uBlurSpread, 6.0);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fboB.fbo);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        // Second vertical pass
        gl.bindTexture(gl.TEXTURE_2D, fboB.tex);
        gl.uniform2f(uBlurDirection, 0.0, 1.0);
        gl.uniform1f(uBlurSpread, 1.8);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fboA.fbo);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        // Third horizontal pass (widest)
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, fboA.tex);
        gl.uniform2f(uBlurDirection, 1.0, 0.0);
        gl.uniform1f(uBlurSpread, 7.5);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fboB.fbo);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        // Third vertical pass
        gl.bindTexture(gl.TEXTURE_2D, fboB.tex);
        gl.uniform2f(uBlurDirection, 0.0, 1.0);
        gl.uniform1f(uBlurSpread, 2.0);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fboA.fbo);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        gl.viewport(0, 0, w, h);
        gl.useProgram(compositeProg);
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, contentTex);
        gl.uniform1i(uOrigTex, 0);
        gl.activeTexture(gl.TEXTURE1);
        gl.bindTexture(gl.TEXTURE_2D, fboA.tex);
        gl.uniform1i(uBloomTex, 1);
        gl.uniform1f(uTime, time / 1000.0);
        gl.uniform1f(uNoiseInt, NOISE_INTENSITY);
        gl.uniform1f(uBloomInt, BLOOM_INTENSITY);
        gl.bindFramebuffer(gl.FRAMEBUFFER, null);
        gl.clearColor(0, 0, 0, 1);
        gl.clear(gl.COLOR_BUFFER_BIT);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);

      function restore() {
        glCanvas.remove();
        var s = document.getElementById('terminal-section');
        if (s) {
          document.body.appendChild(s);
          s.style.cssText = '';
        }
        captureCanvas.remove();
        document.getElementById('fallback-glow').classList.remove('fallback-hidden');
        document.getElementById('fallback-noise').classList.remove('fallback-hidden');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<script>
  (function () {
    var dividers = document.querySelectorAll('.pixel-divider');
    if (!dividers.length) return;
    var accent = getComputedStyle(document.documentElement).getPropertyValue('--color-terminal-orange').trim();
    var ROWS = 4, PX = 2, GAP = 1;
    var H = ROWS * (PX + GAP) + GAP;
    var startTime = performance.now();
    var SPEED = 6;

    var states = [];
    dividers.forEach(function (canvas) {
      var container = canvas.parentElement;
      canvas.style.width = '100%';
      canvas.style.height = H + 'px';
      canvas.height = H;
      var ctx = canvas.getContext('2d');
      var cols = 8;

      function resize() {
        var cw = container.clientWidth;
        cols = Math.max(3, Math.floor((cw - GAP) / (PX + GAP)));
        canvas.width = cols * (PX + GAP) + GAP;
      }

      resize();
      window.addEventListener('resize', resize);
      states.push({ ctx: ctx, cols: cols, canvas: canvas });
    });

    function render(now) {
      var elapsed = (now - startTime) / 1000;

      states.forEach(function (s) {
        var cols = s.cols;
        var scan = Math.floor(elapsed * SPEED) % cols;
        var w = s.canvas.width;
        var ctx = s.ctx;

        ctx.clearRect(0, 0, w, H);
        for (var r = 0; r < ROWS; r++) {
          var ox = r % 2 === 0 ? 0 : (PX + GAP) / 2;
          for (var c = 0; c < cols; c++) {
            var x = GAP + c * (PX + GAP) + ox;
            var y = GAP + r * (PX + GAP);
            var isBar = c === scan || c === (scan + 1) % cols;
            var dist = ((scan - 1 - c) + cols) % cols;
            var alpha = isBar ? 1 : dist < 5 ? 0.5 * (1 - dist / 5) : 0.04;
            ctx.globalAlpha = alpha;
            ctx.fillStyle = accent;
            ctx.fillRect(x, y, PX, PX);
          }
        }
      });

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  })();
</script>

<script>
  setInterval(() => {
    document.getElementById('grid-pattern')?.classList.toggle('inverted');
    document.getElementById('loader-grid')?.classList.toggle('inverted');
  }, 1000);
</script>